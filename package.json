{
  "name": "pnpmkambrium-cm4all-wp-impex",
  "version": "1.0.1",
  "description": "ImpEx is a Wordpress plugin that allows you to import and export data from/to your WordPress site.",
  "scripts": {
    "prepare": "(printenv npm_config_user_agent | grep 'pnpm') && (make --silent init || echo \"failed to initialize @pnpmkambrium/core : please run 'make --silent -f node_modules/@pnpmkambrium/core/make/make.mk init  manually'\")"
  },
  "keywords": [
    "pnpm"
  ],
  "author": {
    "email": "lars.gersmann@ionos.com",
    "name": "lars gersmann"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lgersman/pnpmkambrium-cm4all-wp-impex"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "2.27.1",
    "@commitlint/cli": "17.2.0",
    "@commitlint/config-conventional": "17.2.0",
    "@pnpmkambrium/core": "link:../pnpmkambrium/packages/npm/core",
    "@pnpmkambrium/create": "link:../pnpmkambrium/packages/npm/create",
    "@prettier/plugin-php": "^0.22.2",
    "eslint": "9.9.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "git-cz": "4.9.0",
    "nano-staged": "0.8.0",
    "prettier": "3.3.3",
    "stylelint": "^16.8.2",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-scss": "^6.5.0",
    "@wordpress/env": "8.10.0"
  },
  "dependencies": {
    "@pnpmkambrium-cm4all-wp-impex/gh-pages": "workspace:^",
    "@pnpmkambrium-cm4all-wp-impex/impex-cli": "workspace:^",
    "@pnpmkambrium-cm4all-wp-impex/generator": "workspace:^",
    "@pnpmkambrium-cm4all-wp-impex/cm4all-wp-impex": "workspace:^",
    "@pnpmkambrium-cm4all-wp-impex/cm4all-wp-impex-example": "workspace:^"
